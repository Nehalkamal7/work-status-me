{
  "manifest_version": 3,
  "name": "Enterprise Work Status - WhatsApp Intelligence Extractor",
  "version": "1.0.0",
  "description": "Captures WhatsApp Web chat updates for dynamic AI summarization and task extraction.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Work Status Sync Settings"
  }
}
